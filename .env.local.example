# =============================================================================
# Ambiente local com Keycloak — template para docker-compose.local.yml
# =============================================================================
#
# Copie para .env e substitua os segredos:
#     cp .env.local.example .env
#     # gere cada segredo com: openssl rand -base64 32
#
# docker-compose.local.yml declara `env_file: .env`. Sem esse arquivo o compose
# não sobe. Este template existe porque o único gerador de .env do projeto é o
# `learnhouse setup` (fluxo de self-host), que não é o fluxo do ambiente local.
#
# Guia completo: docs/content/developers/contributing/keycloak-local.mdx

# =============================================================================
# Domínio e hospedagem
# =============================================================================

LEARNHOUSE_DOMAIN=localhost

# OBRIGATÓRIA. A redirect_uri do login corporativo é montada a partir de
# hosting_config.frontend_domain, que NÃO cai para LEARNHOUSE_DOMAIN
# (apps/api/config/config.py). Sem esta linha o valor vem do config.yaml como
# "localhost:3000", divergente da URI registrada no client do realm
# (http://localhost/api/auth/keycloak/callback), e o Keycloak recusa a
# autorização com redirect_uri inválida.
LEARNHOUSE_FRONTEND_DOMAIN=localhost

HTTP_PORT=80

# =============================================================================
# Frontend (NEXT_PUBLIC_*)
# =============================================================================

NEXT_PUBLIC_LEARNHOUSE_API_URL=http://localhost/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_HTTPS=False

# =============================================================================
# NextAuth
# =============================================================================

NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=troque-me-openssl-rand-base64-32

# =============================================================================
# Backend
# =============================================================================

LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:learnhouse@db:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_COOKIE_DOMAIN=.localhost
LEARNHOUSE_PORT=9000

# =============================================================================
# Segurança e conta inicial
# =============================================================================

LEARNHOUSE_AUTH_JWT_SECRET_KEY=troque-me-openssl-rand-base64-32

# ATENÇÃO: o validador de e-mail da aplicação recusa os TLDs reservados
# .test, .example e .localhost. Um e-mail terminando em .test derruba o
# arranque da aplicação com ValidationError em api/cli.py, durante a criação
# do administrador inicial. Use um domínio de TLD comum.
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@e2e-tests.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=troque-me
LEARNHOUSE_INITIAL_ORG_NAME=Default Organization
LEARNHOUSE_INITIAL_ORG_SLUG=default

# =============================================================================
# Servidor de colaboração
# =============================================================================

COLLAB_INTERNAL_KEY=troque-me-openssl-rand-base64-32
LEARNHOUSE_REDIS_URL=redis://redis:6379
NEXT_PUBLIC_COLLAB_URL=ws://localhost/collab

# =============================================================================
# Geral
# =============================================================================

# OBRIGATÓRIA. O issuer local é http://localhost:8080/realms/dev, sem TLS, e
# validate_external_https_url (apps/api/src/services/security/url_validation.py)
# só admite esquema http quando o modo desenvolvimento está ligado.
LEARNHOUSE_DEVELOPMENT_MODE=True

LEARNHOUSE_LOGFIRE_ENABLED=False
LEARNHOUSE_IS_AI_ENABLED=False
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem

# =============================================================================
# Banco de dados
# =============================================================================

POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=learnhouse
POSTGRES_DB=learnhouse

# =============================================================================
# Keycloak — provedor da plataforma
# =============================================================================

LEARNHOUSE_KEYCLOAK_ENABLED=true
LEARNHOUSE_KEYCLOAK_ISSUER=http://localhost:8080/realms/dev
LEARNHOUSE_KEYCLOAK_CLIENT_ID=learnhouse
LEARNHOUSE_KEYCLOAK_CLIENT_SECRET=learnhouse-dev-secret
